{
  "name": "nacfe-assist-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:corpus": "node build_corpus.mjs",
    "dev": "npm run build:corpus && wrangler dev",
    "deploy": "npm run build:corpus && wrangler deploy",
    "db:init": "wrangler d1 execute nacfe-assist --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute nacfe-assist --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
